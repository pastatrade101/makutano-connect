# --- Required (§30) --------------------------------------------------------
# Supabase IS Postgres — its connection string goes in DATABASE_URL. (SUPABASE_DB_URL
# is accepted as an alias if you prefer that name.)
#
#   Supabase → Project Settings → Database → Connection string
#     • App runtime  : "Transaction pooler"  (port 6543) ← DATABASE_URL
#     • Migrations   : "Direct connection"   (port 5432) ← DIRECT_DATABASE_URL
#
#   The pool already runs with prepare:false, which is what the transaction pooler
#   requires. Migrations need the direct URL because DDL and the migrator's advisory
#   lock need a session that survives between statements.
#
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/makutano
DIRECT_DATABASE_URL=
PUBLIC_APP_URL=http://localhost:5173
# 32+ characters. Signs nothing directly today but reserved for token signing.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 16+ characters. Derives the AES-256-GCM key for WhatsApp tokens and webhook
# secrets. CHANGING THIS MAKES EXISTING CIPHERTEXT UNREADABLE — rotate through
# key_version, never by editing this value in place.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key

# --- Meta / WhatsApp (§7) — optional until you switch WhatsApp on ----------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Facebook Login for Business configuration id used by Embedded Signup.
WHATSAPP_CONFIG_ID=
# Must match the token you enter in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# --- Infrastructure --------------------------------------------------------
# Optional. The job queue runs on Postgres; Redis is not required.
REDIS_URL=

# Transactional email. REQUIRED for public self-signup: without it, verification
# links cannot be delivered and the email.send job fails loudly rather than
# pretending to have sent. Provider is Resend (api.resend.com).
#   EMAIL_FROM must be an address on a domain you have verified with the provider.
EMAIL_FROM=
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=

# --- Self-signup -----------------------------------------------------------
# off closes the public /signup page; Platform Admin provisioning keeps working.
SIGNUP_ENABLED=on
# Plan a visitor lands on when they do not choose one.
SIGNUP_DEFAULT_PLAN=STARTER
# Free-trial length in days. 0 disables trials — new tenants then wait in PENDING
# until an admin activates them. Never fake an active paid subscription here.
SIGNUP_TRIAL_DAYS=14
# Cloudflare Turnstile. Leave both blank to run without a challenge; setting both
# switches it on with no code change.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Behaviour -------------------------------------------------------------
NODE_ENV=development
JOB_WORKER=on
JOB_POLL_MS=2000
LOG_LEVEL=info
# Must stay above the app's peak concurrent fan-out — see the note in src/lib/server/env.ts.
# Against Supabase's transaction pooler, exceeding it wedges the process permanently.
DB_POOL_MAX=25

# --- Seeding (optional) ----------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Cloudflare R2 — marketplace media (§35) -------------------------------
# Optional. With ANY of these blank, media upload is unavailable and every other
# feature is untouched — mediaEnabled() gates it, nothing throws at boot.
#
# Use a SEPARATE bucket from Goldfinch's. Marketplace media has a different
# lifecycle (operators upload and delete their own photographs) and mixing them
# means one app's cleanup can orphan the other's images.
#
# The account id, key and secret are SERVER-ONLY: no API returns them, no page
# renders them, and no browser-side upload URL is minted from them. Uploads are
# proxied through Connect, which is what keeps the bucket credential off the
# client entirely. R2_PUBLIC_URL is the only one a browser ever sees.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public r2.dev address, or your own CDN domain. No trailing slash.
R2_PUBLIC_URL=

# --- Tests -----------------------------------------------------------------
# Point at a scratch database to run the mandatory tenant-isolation suite.
TEST_DATABASE_URL=
