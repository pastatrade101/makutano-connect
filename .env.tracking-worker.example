# Copy to .env.tracking-worker on the SERVER, beside .env, and fill in.
# The filled file is gitignored and must never be committed.
#
# WHY A SEPARATE FILE AT ALL
#
# This is the provisioning credential — the one identity that can create Traccar
# devices and grant them to tenants. Keeping it out of .env is the mechanism that
# stops the web container from ever holding it: docker-compose.yml gives .env to
# both services and this file to the worker alone. The isolation is the file
# boundary, not a convention, and it is checkable:
#
#   docker inspect makutano-connect --format '{{json .Config.Env}}' | grep -c TRACCAR_ADMIN
#   # expect 0
#
# The account these name is NOT a Traccar administrator: create it with
# deviceLimit -1 and userLimit -1. An administrator would make every tenant's
# read-only isolation advisory.
TRACCAR_ADMIN_USERNAME=
TRACCAR_ADMIN_PASSWORD=
